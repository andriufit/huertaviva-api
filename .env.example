# Copia este fichero como .env y ajusta los valores.

# Interfaz y puerto en los que escucha la API.
# 127.0.0.1 = solo accesible desde la propia máquina.
# Pon la IP de la interfaz por la que quieras recibir peticiones, o 0.0.0.0 para todas.
HOST=127.0.0.1
PORT=3000

# Conexión a la base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=huertaviva
DB_USER=huerta_api
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA

# Origen desde el que un navegador puede llamar a la API (CORS), por ejemplo:
#   CORS_ORIGIN=https://www.huertaviva.local
# Déjalo vacío si el navegador llama a la API desde el mismo dominio que la web.
CORS_ORIGIN=
